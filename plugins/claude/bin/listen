#!/bin/sh
# switchboard's listener for Claude Code (docs/DESIGN.md §49.4). Claude Code runs it at Stop, with
# asyncRewake: it sends only this session's id and waits at the switchboard server, round after
# round, so the session can be woken however long it stays idle. A message prints, and the exit 2
# makes Claude Code start a turn with it. Exit 0 wakes nothing: when another listener or a hook of
# the session takes over, the session is busy or gone, the token is refused, or Claude Code quits.
# One exception: a session that someone else ended (a kick, a closed room) is told so, once.
# A round that runs out starts the next; a server that can't be reached (restarting, or a proxy
# that cut the wait) is tried again, a little later each time. The token reaches curl on its stdin,
# never its command line, where other processes could read it.
sid=$(grep -o '"session_id": *"[^"]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')
case $sid in '' | *[!A-Za-z0-9_-]*) exit 0 ;; esac
url=${CLAUDE_PLUGIN_OPTION_SERVER_URL:-$SWITCHBOARD_URL}
url=${url%/}
token=${CLAUDE_PLUGIN_OPTION_TOKEN:-$SWITCHBOARD_AGENT_TOKEN}
[ -n "$url" ] && [ -n "$token" ] || exit 0
round=${SWITCHBOARD_LISTEN_S:-900}
case $round in '' | *[!0-9]*) round=900 ;; esac
[ "$round" -ge 10 ] || round=10
owner=${CLAUDE_PID:-$PPID}
body=$(mktemp) || exit 0
code="$body.code"
trap 'rm -f "$body" "$code"' EXIT
trap 'exit 0' HUP INT TERM
again=0
backoff=1
while kill -0 "$owner" 2>/dev/null; do
  began=$(date +%s)
  printf 'header = "Authorization: Bearer %s"\n' "$token" |
    curl -s --max-time $((round + 30)) -K - -o "$body" -w '%{http_code}' -X POST \
      -H "X-Switchboard-Session: $sid" -H "X-Switchboard-Wait: $round" -H "X-Switchboard-Again: $again" \
      "$url/mcp/listen" >"$code" &
  job=$!
  (while kill -0 "$owner" 2>/dev/null; do sleep 2; done; kill "$job" 2>/dev/null) &
  watch=$!
  wait "$job" 2>/dev/null
  kill "$watch" 2>/dev/null
  kill -0 "$owner" 2>/dev/null || exit 0
  again=1
  case $(cat "$code" 2>/dev/null) in
    200) cat "$body" >&2; exit 2 ;;
    410) # someone else ended the session: say so once, or it goes deaf without a word
      seen="${CLAUDE_PLUGIN_DATA:-${TMPDIR:-/tmp}}/switchboard-ended-$sid"
      [ "$(cat "$seen" 2>/dev/null)" = "$(cat "$body")" ] && exit 0
      cp "$body" "$seen" 2>/dev/null
      cat "$body" >&2
      exit 2
      ;;
    408) backoff=1; sleep 1 ;;
    000 | 429 | 500 | 502 | 503 | 504)
      if [ $(($(date +%s) - began)) -ge 10 ]; then
        backoff=1 # a long wait that a proxy cut: wait again at once
      else
        sleep "$backoff"
        [ "$backoff" -ge 60 ] || backoff=$((backoff * 2))
      fi
      ;;
    *) exit 0 ;;
  esac
done
exit 0
