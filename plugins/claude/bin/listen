#!/bin/sh
# switchboard's listener for Claude Code (docs/DESIGN.md §49.4). Claude Code runs it at Stop and
# at SessionStart for startup/resume, with
# asyncRewake: it sends only this session's id and waits at the switchboard server, round after
# round, so the session can be woken however long it stays idle. A message prints, and the exit 2
# makes Claude Code start a turn with it. Exit 0 wakes nothing: when another listener or a hook of
# the session takes over, the session is busy or gone, or Claude Code quits. Any other reason the
# listener stops (a refused token, a server that answers something unexpected) is written to
# listen.log, and the session is woken once with it, as it is when someone else ended it (a kick,
# a closed room): a listener that stops without a word leaves the session deaf (#436).
# A round that runs out starts the next; a server that can't be reached (restarting, or a proxy
# that cut the wait) is tried again, a little later each time. The token reaches curl on its stdin,
# never its command line, where other processes could read it.
# With no typed token (the agent signed in through the browser, and Claude Code keeps that token to itself)
# it presents the listener key that bin/headers made for this Claude Code instead (docs/DESIGN.md §49.11):
# a bearer for this one route, for one session. A resumed session's listener starts before the connection
# has told the server about the key, so at SessionStart it waits up to a minute (SWITCHBOARD_LISTEN_GRACE_S) for
# the key's file and, while the server answers unknown_key, asks again every second; a later Stop's listener
# doesn't wait.
# Git for Windows' sh (Git Bash) is where Claude Code runs this on Windows when Git is installed; there
# the PowerShell version does the job (windows/listen.ps1, #440). Windows without Git runs listen.cmd instead.
case $(uname -s) in
  MINGW* | MSYS* | CYGWIN*)
    [ -f "${0%/*}/windows/listen.ps1" ] &&
      exec powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "${0%/*}/windows/listen.ps1" ;;
esac
input=$(cat)
field() {
  printf '%s' "$input" | grep -o "\"$1\": *\"[^\"]*\"" | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/'
}
event=$(field hook_event_name)
# Claude Code sets this to 0 for -p (observed with 2.1.307). Its background hooks hold the
# one-shot process open, including after Stop; it cannot receive another turn once it exits.
# With the variable absent, keep listening for older Claude Code versions.
[ "${CLAUDE_CODE_SESSION_ATTENDED:-}" = 0 ] && exit 0
# A /clear or compaction can happen mid-turn; its next Stop starts the listener. Starting one
# here would report that busy session idle and could deliver a wake into the running turn.
case $event in
  Stop) ;;
  SessionStart) case $(field source) in startup | resume) ;; *) exit 0 ;; esac ;;
  *) exit 0 ;;
esac
sid=$(field session_id)
case $sid in '' | *[!A-Za-z0-9_-]*) exit 0 ;; esac
url=${CLAUDE_PLUGIN_OPTION_SERVER_URL:-$SWITCHBOARD_URL}
url=${url%/}
token=${CLAUDE_PLUGIN_OPTION_TOKEN:-$SWITCHBOARD_AGENT_TOKEN}
[ -n "$url" ] || exit 0
round=${SWITCHBOARD_LISTEN_S:-900}
case $round in '' | *[!0-9]*) round=900 ;; esac
[ "$round" -ge 10 ] || round=10
grace=${SWITCHBOARD_LISTEN_GRACE_S:-60} # how long a SessionStart listener asks again for a key the server doesn't know yet
case $grace in '' | *[!0-9]*) grace=60 ;; esac
owner=${CLAUDE_PID:-$PPID}
body=$(mktemp) || exit 0
code="$body.code"
trap 'rm -f "$body" "$code"' EXIT
trap 'exit 0' HUP INT TERM
# the plugin's own data folder, or the user's; never a shared one like /tmp, where another account
# could plant the name first
dir=${CLAUDE_PLUGIN_DATA:-${HOME:+$HOME/.cache/switchboard}}
# no typed token: the key bin/headers made for this Claude Code stands in for it
keyfile=
if [ -z "$token" ]; then
  [ -n "$dir" ] || exit 0
  keyfile="$dir/listener-key-$owner"
fi
read_key() { # the key in the key file, if it holds one (sbl_ and 64 hex)
  k=$(cat "$keyfile" 2>/dev/null)
  case $k in sbl_*) ;; *) return 1 ;; esac
  case ${k#sbl_} in '' | *[!0-9a-f]*) return 1 ;; esac
  [ "${#k}" -eq 68 ] || return 1
  printf '%s' "$k"
}
flat() { # what the server said, on one line and cut short: $1 is the body's file
  tr '\r\n' '  ' <"$1" | cut -c1-300
}
logline() { # one line in listen.log: when, the session, the round, the status, what the server said
  [ -n "$dir" ] && mkdir -p "$dir" 2>/dev/null || return 0
  if [ -f "$dir/listen.log" ] && [ "$(wc -c <"$dir/listen.log")" -gt 65536 ]; then # a log that stays small
    tail -n 100 "$dir/listen.log" 2>/dev/null >"$dir/listen.log.tmp" && mv "$dir/listen.log.tmp" "$dir/listen.log"
  fi
  printf '%s session=%s round=%s status=%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sid" "$rounds" "$1" "$2" \
    2>/dev/null >>"$dir/listen.log"
  return 0
}
again=0
backoff=1
rounds=0
first=$(date +%s)
if [ -n "$keyfile" ]; then
  until token=$(read_key); do
    # the helper runs as Claude Code connects the server, which can be just after this hook starts
    if [ "$event" = SessionStart ] && [ $(($(date +%s) - first)) -lt "$grace" ] && kill -0 "$owner" 2>/dev/null; then
      sleep 1
    else
      logline nokey "no listener key in $keyfile"
      exit 0
    fi
  done
fi
if [ -n "$keyfile" ]; then
  fix='Sign in to switchboard again from Claude Code (/mcp, then Authenticate).'
else
  fix='Check the plugin settings, the server address and the agent token.'
fi
stopped() { # a reason nobody expects, such as a token that was refused: log it, and wake the session once
  # with it, because nothing else would tell it the listener is gone. The marker keeps the same
  # reason from waking it again at every later Stop; a wake clears it.
  logline "$status" "$said"
  [ -n "$dir" ] && mkdir -p "$dir" 2>/dev/null || exit 0
  marker="$dir/stopped-$sid"
  # only switchboard's own error word goes to the model, never the rest of the body: whatever
  # stood in the way (a proxy's page) is in the log
  what=$(printf '%s' "$said" | grep -o '"error": *"[A-Za-z0-9_-]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')
  reason="$status $what"
  [ "$(cat "$marker" 2>/dev/null)" = "$reason" ] && exit 0
  printf '%s' "$reason" 2>/dev/null >"$marker" || exit 0 # no marker, no wake: it could loop the session awake
  printf '[switchboard] The listener for this session stopped, so room messages can no longer wake it while it is idle: the server answered %s%s. %s The listener starts again at the end of this session'"'"'s next turn. Details: %s/listen.log\n' \
    "$status" "${what:+ ($what)}" "$fix" "$dir" >&2
  exit 2
}
while kill -0 "$owner" 2>/dev/null; do
  rounds=$((rounds + 1))
  began=$(date +%s)
  if [ -n "$keyfile" ]; then k=$(read_key) && token=$k; fi # a reconnect makes a new key: the newest one
  printf 'header = "Authorization: Bearer %s"\n' "$token" |
    curl -s --max-time $((round + 30)) -K - -o "$body" -w '%{http_code}' -X POST \
      -H "X-Switchboard-Session: $sid" -H "X-Switchboard-Wait: $round" -H "X-Switchboard-Again: $again" \
      "$url/mcp/listen" >"$code" &
  job=$!
  (while kill -0 "$owner" 2>/dev/null; do sleep 2; done; kill "$job" 2>/dev/null) &
  watch=$!
  wait "$job" 2>/dev/null
  kill "$watch" 2>/dev/null
  kill -0 "$owner" 2>/dev/null || exit 0
  again=1
  status=$(cat "$code" 2>/dev/null)
  said=$(flat "$body")
  case $status in
    200) [ -n "$dir" ] && rm -f "$dir/stopped-$sid" 2>/dev/null; cat "$body" >&2; exit 2 ;;
    410) # someone else ended the session: say so once, or it goes deaf without a word
      logline 410 "$said"
      [ -n "$dir" ] && mkdir -p "$dir" 2>/dev/null || exit 0
      seen="$dir/ended-$sid"
      [ "$(cat "$seen" 2>/dev/null)" = "$(cat "$body")" ] && exit 0
      cp "$body" "$seen" 2>/dev/null || exit 0 # no marker, no wake: it could loop the session awake
      cat "$body" >&2
      exit 2
      ;;
    408) backoff=1; sleep 1 ;;
    '' | 000 | 429 | 500 | 502 | 503 | 504)
      if [ $(($(date +%s) - began)) -ge 10 ]; then
        backoff=1 # a long wait that a proxy cut: wait again at once
      else
        sleep "$backoff"
        [ "$backoff" -ge 60 ] || backoff=$((backoff * 2))
      fi
      ;;
    409) # busy (a turn is running: its next Stop listens) or taken over by a newer listener or
      # another hook of the session, which is every turn's ordinary end: only a refusal is logged
      case $said in *'"not_idle"'*) logline 409 "$said" ;; esac
      exit 0
      ;;
    401) # with a key: not known yet is asked again, for a minute at SessionStart; any other refusal is told
      if [ -n "$keyfile" ]; then
        case $said in
          *'"unknown_key"'*)
            if [ "$event" = SessionStart ] && [ $(($(date +%s) - first)) -lt "$grace" ]; then
              again=0 # not parked yet: this is still the first round
              sleep 1
              continue
            fi
            logline "$status" "$said" # a Stop's listener, or a key that is not coming: nothing to wake for
            exit 0
            ;;
        esac
      fi
      stopped
      ;;
    403) # a key is for one session: a round for another (after /clear) is a refusal to log, not to wake for
      if [ -n "$keyfile" ]; then
        case $said in *'"wrong_session"'*) logline "$status" "$said"; exit 0 ;; esac
      fi
      stopped
      ;;
    *) stopped ;;
  esac
done
exit 0
