# The fixes to joinly 0.5.4 that a hosted call's joinly mounts over its own files (docs/DEPLOY.md, "A meeting
# bot"; DESIGN.md sections 54 and 52.5). None is in a joinly release yet; drop a line, and its mount in compose.yaml,
# once one is. The host script (bin/meeting-host) gets each file when it does not have it, and uses it only if its
# sha256 is the one here: a file that differs is refused, never mounted. A URL names a commit of the joinly fork, so
# it does not move. `plugin:<path>` is a file this plugin ships under meeting/ (no download); the same two files are
# in deploy/joinly/, and tests/unit/test_joinly_voice_patch.py keeps every copy identical and checks these hashes
# against the self-test's and DEPLOY.md's.
#
# file  sha256  url or plugin:path
zoom.py 9bf581c20a9a7911afb9f2ac1447a5d0800cdca24485dd215099d5d82afad6ff https://raw.githubusercontent.com/amahpour/joinly/9fbd07ceccbbfc358d697378c3cb1d7b911b17a5/joinly/providers/browser/platforms/zoom.py
transcription.py 6053ca7c6b100952c91e14f2552b82eaf92bcde6a809d627f040479dc6d39d97 https://raw.githubusercontent.com/amahpour/joinly/1fe384d9deba32f38fabd5bfc77fc5975adef6a7/joinly/controllers/transcription/default.py
server.py b168efc06793f6ee1873f1f9d28bd8e01692a4577408a1637968ad2b2d6a38c0 plugin:joinly/server.py
kokoro.py d64834fc3146261df194c8da6e3c392f058b317fa7cc56953a2bb4b553c065b3 plugin:joinly/kokoro.py
