{
  "description": "switchboard: which session makes each call, its status, and waking it when idle (docs/DESIGN.md \u00a749.4)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/bin\"; ./session; exit $LASTEXITCODE",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/bin\"; ./listen; exit $LASTEXITCODE",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard:switchboard",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_switchboard_switchboard__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard:switchboard",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_switchboard_switchboard__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard:switchboard",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_response": "${tool_response}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?!mcp__plugin_switchboard_switchboard__)",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard:switchboard",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__plugin_switchboard_switchboard__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard:switchboard",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}"
            },
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?!mcp__plugin_switchboard_switchboard__)",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard:switchboard",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:switchboard:switchboard",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "notification_type": "${notification_type}"
            },
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/bin\"; ./listen; exit $LASTEXITCODE",
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/bin\"; ./session; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
