{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/hook\" pre",
        "matcher": "MCP:switchboard_.*",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/hook\" post",
        "matcher": "MCP:switchboard_.*",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/hook\" failure",
        "matcher": "MCP:switchboard_.*",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/hook\" start",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/hook\" stop",
        "timeout": 660,
        "loop_limit": null
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/hook\" end",
        "timeout": 10
      }
    ]
  }
}
